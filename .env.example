# ============================================================================
# EksporFlow — Konfigurasi Environment Lokal (.env)
# Salin file ini menjadi `.env` (jangan pernah commit `.env` ke Git!)
# ============================================================================

# 1. Database PostgreSQL / Supabase (WAJIB untuk simpan transaksi ke cloud)
# Gunakan Connection String dari Supabase Dashboard -> Connect -> Transaction Pooler (port 6543)
# atau Session Pooler (port 5432). Ganti [YOUR-PASSWORD] dengan password database Supabase Anda.
DATABASE_URL="postgresql://postgres.PROJECT_REF:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres"

# 2. Mode Login Lokal untuk Development (tanpa server OAuth Manus)
# Hanya aktif saat NODE_ENV=development dan ALLOW_DEV_LOGIN=true.
# Jangan aktifkan di production!
ALLOW_DEV_LOGIN="true"
MANUS_PROJECT_ID="eksporflow-local"
MANUS_JWT_SECRET="ganti-dengan-string-acak-minimal-32-karakter-rahasia"

# 3. Port server lokal (opsional, default 3000)
PORT="3000"

# 4. Opsional — Manus OAuth & Copilot LLM (jika dideploy ke runtime Manus / kompatibel OpenAI)
# MANUS_OAUTH_API_URL=""
# MANUS_API_URL=""
# MANUS_API_KEY=""
